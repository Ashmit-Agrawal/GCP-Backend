# ===============================================
# Green Credit Programme (GCP) - Environment Config
# ===============================================

# PostgreSQL Configuration (External dependency)
POSTGRES_DB=gcpdb
POSTGRES_USER=gcp_admin
POSTGRES_PASSWORD=gcp_password
POSTGRES_PORT=5432

# MongoDB Configuration (External dependency for Land Data)
MONGO_DB=gcpdb
MONGO_PORT=27017

# Backend Application Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gcpdb
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/gcpdb
# Generate a cryptographically secure random key (at least 32 bytes / 256 bits):
# Linux example: openssl rand -hex 32
JWT_SECRET=your_secure_random_jwt_secret_must_be_at_least_32_bytes_long_here!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
GCP_SEED_DEMO_DATA=false
